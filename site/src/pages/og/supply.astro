---
// Share card source page: the supply (SPR) chart as a 1200x630 Open Graph image.
// NOT a site page — excluded from the sitemap and robots. scripts/make-og.mjs
// renders this route with headless Chrome to /og-supply.png after each build.
// Keep it self-contained: fixed size, no animation, no tooltips, fonts via the
// same Google Fonts link as the site (headless Chrome loads them fine).
import { sprWeekly, sprPreWar, DATA_AS_OF, CRISIS_DAY_1 } from "../../data/crisis.ts";

const dayNum = Math.round(
  (Date.parse(DATA_AS_OF) - Date.parse(CRISIS_DAY_1)) / 86400000
);
const last = sprWeekly[sprWeekly.length - 1];
const fmt = (iso: string) =>
  new Date(iso + "T12:00:00").toLocaleDateString("en-US", {
    timeZone: "UTC",
    month: "short",
    day: "numeric",
  });
const asOf = new Date(DATA_AS_OF + "T12:00:00").toLocaleDateString("en-US", {
  timeZone: "UTC",
  month: "long",
  day: "numeric",
  year: "numeric",
});
const drawn = +(sprPreWar - last.level).toFixed(1);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>The Depletion Ledger — share card</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
      body {
        background: #f2f1ec;
        color: #1c1b17;
        font-family: "Archivo", ui-sans-serif, system-ui, sans-serif;
      }
      .mono {
        font-family: "IBM Plex Mono", ui-monospace, monospace;
      }
      .faint {
        color: #8a867a;
      }
      .swatch {
        display: inline-block;
        width: 20px;
        border-top-width: 2px;
        margin-right: 6px;
        transform: translateY(-3px);
      }
    </style>
  </head>
  <body>
    <div
      style="width: 1200px; height: 630px; box-sizing: border-box; padding: 48px 64px 40px; display: flex; flex-direction: column;"
    >
      <div class="mono faint" style="font-size: 12.5px; letter-spacing: 0.14em;">
        THE DEPLETION LEDGER · HORMUZ & RED SEA · DAY {dayNum}
      </div>
      <h1 style="margin: 12px 0 0; font-size: 40px; line-height: 1.05; font-weight: 800; letter-spacing: -0.02em;">
        The emergency oil reserve is shrinking
      </h1>
      <p class="faint" style="margin: 10px 0 0; font-size: 15px;">
        US Strategic Petroleum Reserve, million barrels. Solid line: EIA reports. Dotted lines:
        reserve thresholds. Updated {asOf}.
      </p>

      <div
        class="mono faint"
        style="margin-top: 18px; font-size: 12px; display: flex; gap: 28px; align-items: center;"
      >
        <span><span class="swatch" style="border-top-style: solid; border-top-color: #1c1b17;"></span>actual (EIA weekly)</span>
        <span><span class="swatch" style="border-top-style: dotted; border-top-color: rgba(179,38,30,0.55);"></span>reserve thresholds</span>
      </div>

      <div style="position: relative; flex: 1; margin-top: 8px;">
        <canvas id="card"></canvas>
      </div>

      <div
        class="mono faint"
        style="display: flex; justify-content: space-between; font-size: 12.5px; margin-top: 14px;"
      >
        <span>
          {last.level.toFixed(1)}M barrels as of {fmt(last.date)} · down {drawn}M from {sprPreWar.toFixed(1)}M before the war
        </span>
        <span>depletion.org</span>
      </div>
    </div>

    <script>
      import Chart from "chart.js/auto";
      import { sprWeekly } from "../../data/crisis.ts";

      const fmt = (iso: string) =>
        new Date(iso + "T12:00:00").toLocaleDateString("en-US", {
          timeZone: "UTC",
          month: "short",
          day: "numeric",
        });
      const labels = sprWeekly.map((p) => fmt(p.date));
      const anchorIdx = sprWeekly.length - 1;
      const anchorLevel = sprWeekly[anchorIdx].level;

      const directLabels = {
        id: "directLabels",
        afterDatasetsDraw(chart: Chart) {
          const { ctx } = chart;
          const x = chart.scales.x;
          const y = chart.scales.y;
          // floor lines: label at the left edge
          const floors = [250, 180];
          ctx.save();
          ctx.font = "500 11.5px 'IBM Plex Mono', monospace";
          ctx.fillStyle = "rgba(179,38,30,0.75)";
          for (const f of floors) {
            ctx.fillText(
              f === 250 ? "250M · GEF withdrawal threshold" : "180M · operating limit",
              x.getPixelForValue(1) + 6,
              y.getPixelForValue(f) - 6
            );
          }
          ctx.restore();
        },
      };

      new Chart(document.getElementById("card")!, {
        type: "line",
        data: {
          labels,
          datasets: [
            {
              data: sprWeekly.map((p) => p.level),
              borderColor: "#1c1b17",
              borderWidth: 2.5,
              pointRadius: 0,
              tension: 0.1,
              spanGaps: false,
            },
            ...[250, 180].map((f) => ({
              data: labels.map(() => f),
              borderColor: "rgba(179,38,30,0.35)",
              borderDash: [2, 5],
              borderWidth: 1,
              pointRadius: 0,
            })),
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: false, // deterministic screenshots
          events: [], // no interaction on a card
          scales: {
            y: {
              min: 140,
              max: 420,
              grid: { display: false },
              border: { display: false },
              ticks: {
                color: "#8a867a",
                padding: 8,
                stepSize: 50,
                font: { family: "'IBM Plex Mono', monospace", size: 11.5 },
                callback: (v: unknown) => `${v}M`,
              },
            },
            x: {
              grid: { display: false },
              border: { color: "#d8d4c6" },
              ticks: {
                color: "#8a867a",
                padding: 6,
                maxTicksLimit: 8,
                font: { family: "'IBM Plex Mono', monospace", size: 11.5 },
              },
            },
          },
          plugins: { tooltip: { enabled: false }, legend: { display: false } },
        },
        plugins: [directLabels],
      });
    </script>
  </body>
</html>

---
// Share card: observed inventories, EIA outlook and recent trend, matching
// the dashboard after the October 21 scenario withdrawal.
// NOT a site page — excluded from the sitemap and robots. scripts/make-og.mjs
// renders this route with headless Chrome to /og-supply.png after each build.
// Keep it self-contained: fixed size, no animation, no tooltips, fonts via the
// same Google Fonts link as the site (headless Chrome loads them fine).
//
// Data: the SAME forecast records the dashboard's Panel B draws
// (src/data/world-stocks.json), rebased to the shared anchor exactly like the
// dashboard (displayed = stored − stored anchor; records are never modified).
import { DATA_AS_OF, CRISIS_DAY_1 } from "../../data/crisis.ts";
import ws from "../../data/world-stocks.json";

const dayNum = Math.round(
  (Date.parse(DATA_AS_OF) - Date.parse(CRISIS_DAY_1)) / 86400000
);
const asOf = new Date(DATA_AS_OF + "T12:00:00").toLocaleDateString("en-US", {
  timeZone: "UTC",
  month: "long",
  day: "numeric",
  year: "numeric",
});

// ---- Same record selection + rebasing as the dashboard's Panel B ----
const records = (ws as any).forecast_records;
const byId = (id: string) => records.find((r: any) => r.record_id === id);
const recEia = byId("steo-2026-10-global-observed");
const recTrend = byId("persistence-2026-09-global-observed");
if (!recEia || !recTrend) throw new Error("og card: missing comparison record");
const anchor = recEia.anchor;
if (recTrend.anchor.period !== anchor.period || recTrend.anchor.value_mb !== anchor.value_mb)
  throw new Error("og card: comparison records disagree on the anchor");
const rebase = (v: number) => v - anchor.value_mb;

const axisSet = new Set<string>();
for (const r of [recEia, recTrend]) {
  axisSet.add(r.anchor.period);
  for (const t of r.targets) axisSet.add(t.period);
  // Include any saved restart month in addition to the comparison targets.
  if (r.rebase_start) axisSet.add(r.rebase_start.period);
}
const labels = [...axisSet].sort();
const line = (rec: any): (number | null)[] =>
  labels.map((m) => {
    const t = rec.targets.find((t: any) => t.period === m);
    if (t) return rebase(t.target_cumulative_mb);
    // rebased (v2) records restart the cumulative at the observed rebase_start month
    // (September, −2) and have no value before it — August is null, not 0
    if (rec.rebase_start && m === rec.rebase_start.period) return rebase(rec.rebase_start.value_mb);
    if (rec.rebase_start && m < rec.rebase_start.period) return null;
    if (m === rec.anchor.period) return 0;
    return null;
  });
const eiaLine = line(recEia);
const trendLine = line(recTrend);
const anchorMonthStr = new Date(anchor.period + "-15T12:00:00").toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
});
const signFmt = (v: number) => `${v > 0 ? "+" : "−"}${Math.abs(Math.round(v)).toLocaleString()}`;
const end = (l: (number | null)[]) => l[labels.length - 1] as number;
const eiaEnd = end(eiaLine);
const trendEnd = end(trendLine);
const endMonthStr = new Date(labels[labels.length - 1] + "-15T12:00:00").toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>The Depletion Ledger — share card</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
      body {
        background: #f2f1ec;
        color: #1c1b17;
        font-family: "Archivo", ui-sans-serif, system-ui, sans-serif;
      }
      .mono {
        font-family: "IBM Plex Mono", ui-monospace, monospace;
      }
      .faint {
        color: #8a867a;
      }
    </style>
  </head>
  <body>
    <div
      style="width: 1200px; height: 630px; box-sizing: border-box; padding: 44px 64px 36px; display: flex; flex-direction: column;"
    >
      <div class="mono faint" style="font-size: 12.5px; letter-spacing: 0.14em;">
        THE DEPLETION LEDGER · HORMUZ & RED SEA · DAY {dayNum}
      </div>
      <h1 style="margin: 10px 0 0; font-size: 38px; line-height: 1.05; font-weight: 800; letter-spacing: -0.02em;">
        Oil inventories: observations and outlook
      </h1>
      <p class="faint" style="margin: 8px 0 0; font-size: 14.5px;">
        Change in global oil inventories since {anchorMonthStr}, in million barrels. Zero means
        unchanged stocks, not empty tanks. Dark: IEA observations through September. Dashed:
        EIA October 6 outlook. Dotted: June–August trend continued. Coverage differs. Updated {asOf}.
      </p>

      <div style="position: relative; flex: 1; margin-top: 16px;">
        <canvas id="card"></canvas>
      </div>

      <div
        class="mono faint"
        style="display: flex; justify-content: space-between; font-size: 12.5px; margin-top: 12px;"
      >
        <span>
          {endMonthStr}: EIA {signFmt(eiaEnd)} · recent trend {signFmt(trendEnd)} million barrels
        </span>
        <span>depletion.org</span>
      </div>

      <script>
        import Chart from "chart.js/auto";
        import ws from "../../data/world-stocks.json";

        // Same saved comparison records and display transform as dashboard Panel B.
        const records = (ws as any).forecast_records;
        const byId = (id: string) => records.find((r: any) => r.record_id === id);
        const recEia = byId("steo-2026-10-global-observed");
        const recTrend = byId("persistence-2026-09-global-observed");
        const anchor = recEia.anchor;
        const rebase = (v: number) => v - anchor.value_mb;
        const axisSet = new Set<string>();
        for (const r of [recEia, recTrend]) {
          axisSet.add(r.anchor.period);
          for (const t of r.targets) axisSet.add(t.period);
          if (r.rebase_start) axisSet.add(r.rebase_start.period);
        }
        const labels = [...axisSet].sort();
        const line = (rec: any): (number | null)[] => labels.map((m) => {
          const t = rec.targets.find((t: any) => t.period === m);
          if (t) return rebase(t.target_cumulative_mb);
          if (rec.rebase_start && m === rec.rebase_start.period) return rebase(rec.rebase_start.value_mb);
          if (rec.rebase_start && m < rec.rebase_start.period) return null;
          return m === rec.anchor.period ? 0 : null;
        });
        const eiaLine = line(recEia);
        const trendLine = line(recTrend);
        const observed = (ws as any).series.global_observed_cumulative_mb.points;
        const obsLine = labels.map((m) => {
          const p = observed.find((p: any) => p.period === m && p.value != null);
          return p ? rebase(p.value) : null;
        });
        const vals = [...eiaLine, ...trendLine, ...obsLine].filter((v): v is number => v != null);
        const lo = Math.min(0, ...vals), hi = Math.max(0, ...vals);
        const pad = (hi - lo) * 0.15;
        const axisMin = Math.floor((lo - pad) / 250) * 250;
        const axisMax = Math.ceil((hi + pad) / 250) * 250;
        const anchorMonth = new Date(anchor.period + "-15T12:00:00").toLocaleDateString("en-US", {
          month: "long", year: "numeric",
        });

        // Zero reference line with its label (the zero's meaning lives on the chart,
        // like the dashboard's Panel B)
        const refLabels = {
          id: "refLabels",
          afterDatasetsDraw(chart: Chart) {
            const { ctx, chartArea, scales } = chart;
            const y = scales.y.getPixelForValue(0);
            if (y < chartArea.top + 8 || y > chartArea.bottom - 6) return;
            ctx.save();
            ctx.font = "11px Georgia, serif";
            ctx.fillStyle = "#8a867a";
            ctx.textBaseline = "bottom";
            ctx.textAlign = "right";
            ctx.fillText(`0 — no change since ${anchorMonth}`, chartArea.right - 6, y - 3);
            ctx.restore();
          },
        };

        const comparisonDs = (
          data: (number | null)[],
          color: string,
          dash: number[] | undefined
        ) => ({
          type: "line" as const,
          data,
          borderColor: color,
          borderWidth: 2.2,
          ...(dash ? { borderDash: dash } : {}),
          pointRadius: 0,
          tension: 0,
        });

        new Chart(document.getElementById("card")!, {
          type: "line",
          data: {
            labels,
            datasets: [
              // Zero baseline (the "no change" reference), like Panel B's first dataset
              {
                type: "line" as const,
                data: labels.map(() => 0),
                borderColor: "#8a867a",
                borderWidth: 1,
                pointRadius: 0,
              },
              { ...comparisonDs(eiaLine, "#6b675c", [7, 4]), label: "EIA outlook" },
              { ...comparisonDs(trendLine, "#a39d8f", [2, 3]), label: "Recent trend" },
              { ...comparisonDs(obsLine, "#1c1b17", undefined), label: "Observed (IEA)", pointRadius: 3, spanGaps: false },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false, // deterministic screenshots
            events: [], // no interaction on a card
            layout: { padding: { top: 14, right: 12, bottom: 4 } },
            scales: {
              y: {
                min: axisMin,
                max: axisMax,
                afterBuildTicks: (scale: { ticks: { value: number }[] }) => {
                  const ticks = new Set([axisMin, axisMax]);
                  for (let v = Math.ceil(axisMin / 500) * 500; v <= axisMax; v += 500) ticks.add(v);
                  scale.ticks = [...ticks].sort((a, b) => a - b).map(value => ({ value }));
                },
                grid: { display: false },
                border: { display: false },
                ticks: {
                  color: "#8a867a",
                  padding: 8,
                  stepSize: 500,
                  font: { family: "'IBM Plex Mono', monospace", size: 12 },
                  callback: (v: unknown) => Math.round(Number(v)).toLocaleString("en-US"),
                },
              },
              x: {
                grid: { display: false },
                border: { color: "#d8d4c6" },
                ticks: {
                  color: "#8a867a",
                  padding: 6,
                  autoSkip: false,
                  font: { family: "'IBM Plex Mono', monospace", size: 11.5 },
                  callback: (_v: unknown, i: number) => {
                    const m = labels[i];
                    const mm = Number(m.slice(5));
                    if (i === 0 || i === labels.length - 1)
                      return `${new Date(m + "-15T12:00:00").toLocaleDateString("en-US", { month: "short" })} ’${m.slice(2, 4)}`;
                    if (mm !== 1 && mm !== 4 && mm !== 7 && mm !== 10) return "";
                    if (i <= 2 || labels.length - 1 - i <= 1) return "";
                    return mm === 1
                      ? `Jan ’${m.slice(2, 4)}`
                      : new Date(m + "-15T12:00:00").toLocaleDateString("en-US", { month: "short" });
                  },
                },
              },
            },
            plugins: { tooltip: { enabled: false }, legend: { display: false } },
          },
          plugins: [refLabels],
        });
      </script>
    </div>
  </body>
</html>

      // thinned to story beats — diesel: pre-Sep 3 plus Sep 3, 6, 10, 14, 17 and the Sep 22
      // record point (Sep 23 skipped so the last two dots don't blur at ~3px/day);
      // gasoline: pre-Sep 3 plus Sep 10, 17, 22 — because a run of daily dots bunches into
      // ~30px at the right edge. The nearest-WTI pairing below runs over the FULL wtiWeekly either way.
      const dieCrackSrc = dieselYtd.filter(

      // Panel B: the change in global inventories under the three scenarios, rebased to the
      // shared anchor (0 = the anchor month's reported level). The historical bars and
      // cumulative dots are no longer drawn — their data stays in the file; this chart shows
      // the three scenario lines by default, with the EIA and persistence paths as opt-in
      // overlays (checkboxes), drawn more lightly. Rebased values are a DISPLAY transform
      // only: displayed = stored − stored anchor; the records are never modified. Checkbox
      // visibility is chart state only — scoring reads the records, not the chart.
      {
        const eiaRec = (ws as any).forecast_records.find((r: any) => r.record_id === "steo-2026-09-global-observed");
        const persRec = (ws as any).forecast_records.find((r: any) => r.record_id === "persistence-2026-09-global-observed");
        // Phase 3 scenario records + colors (from the assumptions file's scenario list).
        const scColor = (id: string) => (worldStocksAssumptions as any).scenarios.find((s: any) => s.id === id)?.color ?? "#8a867a";
        const scName = (id: string) => (worldStocksAssumptions as any).scenarios.find((s: any) => s.id === id)?.name ?? id;
        // Active scenario version — same rule as the page frontmatter and the drift
        // checker: the newest version date among the scenario record ids.
        const activeVersion = (ws as any).forecast_records
          .filter((r: any) => typeof r.record_id === "string" && r.record_id.startsWith("scenario-"))
          .reduce((max: string, r: any) => {
            const m = r.record_id.match(/-(\d{4}-\d{2}-\d{2})-global-observed$/);
            return m && m[1] > max ? m[1] : max;
          }, "");
        const scHoldsRec = (ws as any).forecast_records.find((r: any) => r.record_id === `scenario-corridor-holds-${activeVersion}-global-observed`);
        const scStandoffRec = (ws as any).forecast_records.find((r: any) => r.record_id === `scenario-standoff-${activeVersion}-global-observed`);
        const scLapseRec = (ws as any).forecast_records.find((r: any) => r.record_id === `scenario-corridor-lapses-${activeVersion}-global-observed`);
        // One shared anchor for all five paths — verify before comparing them on one zero.
        const anchorRec = scHoldsRec.anchor;
        for (const rec of [eiaRec, persRec, scHoldsRec, scStandoffRec, scLapseRec]) {
          if (rec.anchor.period !== anchorRec.period || rec.anchor.value_mb !== anchorRec.value_mb) {
            throw new Error("globalObservedChart: records disagree on the anchor; the rebased paths would not share a zero.");
          }
        }
        const rebase = (v: number) => v - anchorRec.value_mb;
        const anchorMonthStr = new Date(anchorRec.period + "-15T12:00:00").toLocaleDateString("en-US", { month: "long", year: "numeric" });
        const anchorMonthShort = new Date(anchorRec.period + "-15T12:00:00").toLocaleDateString("en-US", { month: "short", year: "numeric" });
        // Axis: the records' anchor month through their shared horizon — derived from the
        // records (anchor period + every target month), not re-typed.
        const axisSet = new Set<string>();
        for (const rec of [eiaRec, persRec, scHoldsRec, scStandoffRec, scLapseRec]) {
          axisSet.add(rec.anchor.period);
          for (const t of rec.targets) axisSet.add(t.period);
        }
        const labelsB = [...axisSet].sort();
        const axisIdx = (m: string) => labelsB.indexOf(m);
        // Rebased paths from the records (the stored targets are the source of truth): each
        // target on its own period, the anchor on the record's STORED anchor period — never
        // "the last cumulative point", so a revised or newly published observation can never
        // move the path.
        const fcLine = (rec: any): (number | null)[] =>
          labelsB.map((m) => {
            const t = rec.targets.find((t: any) => t.period === m);
            if (t) return rebase(t.target_cumulative_mb);
            if (m === rec.anchor.period) return 0; // stored anchor − stored anchor
            return null;
          });
        const eiaLine = fcLine(eiaRec);
        const persLine = fcLine(persRec);
        const holdsLine = fcLine(scHoldsRec);
        const standoffLine = fcLine(scStandoffRec);
        const lapseLine = fcLine(scLapseRec);
        const signFmt = (v: number) => `${v > 0 ? "+" : "−"}${Math.abs(Math.round(v)).toLocaleString()}`;
        const pbCanvas = document.getElementById("globalObservedChart")!;
        new Chart(pbCanvas, {
          type: "line",
          data: {
            labels: labelsB,
            datasets: [
              {
                type: "line" as const,
                label: `No change since ${anchorMonthStr}`,
                data: labelsB.map(() => 0),
                borderColor: "#8a867a",
                borderWidth: 1,
                pointRadius: 0,
                fill: false,
              },
              // The three scenarios: the site's scenario colors, thin lines with hollow
              // markers. Distinguishable patterns, not color alone: solid / short dash /
              // long dash.
              {
                type: "line" as const,
                label: `Corridor holds (mb since ${anchorMonthShort})`,
                data: holdsLine,
                borderColor: scColor("corridor-holds"),
                borderWidth: 1.2,
                pointRadius: 2,
                pointHoverRadius: 3.5,
                pointBackgroundColor: "#faf9f5",
                pointBorderColor: scColor("corridor-holds"),
                pointBorderWidth: 1,
                tension: 0,
              },
              {
                type: "line" as const,
                label: `Standoff (mb since ${anchorMonthShort})`,
                data: standoffLine,
                borderColor: scColor("standoff"),
                borderWidth: 1.2,
                borderDash: [5, 3],
                pointRadius: 2,
                pointHoverRadius: 3.5,
                pointBackgroundColor: "#faf9f5",
                pointBorderColor: scColor("standoff"),
                pointBorderWidth: 1,
                tension: 0,
              },
              {
                type: "line" as const,
                label: `Corridor lapses (mb since ${anchorMonthShort})`,
                data: lapseLine,
                borderColor: scColor("corridor-lapses"),
                borderWidth: 1.2,
                borderDash: [10, 4],
                pointRadius: 2,
                pointHoverRadius: 3.5,
                pointBackgroundColor: "#faf9f5",
                pointBorderColor: scColor("corridor-lapses"),
                pointBorderWidth: 1,
                tension: 0,
              },
              // Opt-in overlays, OFF by default and drawn more lightly than the scenarios:
              // thinner, lighter, smaller markers. Same dash identities as before.
              {
                type: "line" as const,
                label: `EIA forecast (mb since ${anchorMonthShort})`,
                data: eiaLine,
                borderColor: "rgba(107,103,92,0.55)",
                borderWidth: 1,
                borderDash: [7, 4],
                pointRadius: 1.5,
                pointHoverRadius: 3,
                pointBackgroundColor: "#faf9f5",
                pointBorderColor: "rgba(107,103,92,0.55)",
                pointBorderWidth: 1,
                tension: 0,
                hidden: true,
              },
              {
                type: "line" as const,
                label: `Recent trend (mb since ${anchorMonthShort})`,
                data: persLine,
                borderColor: "rgba(163,157,143,0.7)",
                borderWidth: 1,
                borderDash: [2, 3],
                pointRadius: 1.5,
                pointHoverRadius: 3,
                pointBackgroundColor: "#faf9f5",
                pointBorderColor: "rgba(163,157,143,0.7)",
                pointBorderWidth: 1,
                tension: 0,
                hidden: true,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: "index", axis: "x", intersect: false },
            // Right padding keeps the final tick ("Dec ’27", centered on the last band)
            // inside the canvas instead of clipping at the edge.
            layout: { padding: { top: 18, right: 12 } },
            scales: {
              // The zero's reference lives in the horizontal reference label and the prose;
              // the full sentence clipped at mobile widths when it was in the axis title.
              y: yScale(-3600, 2100, (v) => `${v}`, 6, "Change in inventories, million barrels"),
              x: {
                grid: { display: false },
                border: { display: true, color: "#d8d4c6", width: 0.5 },
                ticks: {
                  color: "#8a867a",
                  padding: 8,
                  font: { size: 10 },
                  autoSkip: false,
                  callback: (_v: unknown, i: number) => {
                    const m = labelsB[i];
                    const mm = Number(m.slice(5));
                    // The first month IS the anchor and the last IS the shared horizon —
                    // label both so the chart's span is visible on the axis itself.
                    if (i === 0 || i === labelsB.length - 1)
                      return `${new Date(m + "-15T12:00:00").toLocaleDateString("en-US", { month: "short" })} ’${m.slice(2, 4)}`;
                    if (mm !== 1 && mm !== 4 && mm !== 7 && mm !== 10) return "";
                    // Keep quarterly ticks 3+ months away from both labeled ends, or the
                    // neighbors crowd at narrow widths (e.g. "Oct" colliding with "Dec ’27").
                    if (i <= 3 || labelsB.length - 1 - i <= 2) return "";
                    if (mm === 1) return `Jan ’${m.slice(2, 4)}`;
                    return new Date(m + "-15T12:00:00").toLocaleDateString("en-US", { month: "short" });
                  },
                },
              },
            },
            plugins: {
              tooltip: {
                filter: (item) => item.datasetIndex !== 0 && item.parsed.y !== null,
                callbacks: {
                  title: (items) =>
                    new Date(labelsB[items[0].dataIndex] + "-15T12:00:00").toLocaleDateString("en-US", {
                      month: "long",
                      year: "numeric",
                    }),
                  label: (ctx) => {
                    if (ctx.parsed.y === null) return null;
                    if (ctx.datasetIndex >= 1 && ctx.datasetIndex <= 3) {
                      const sid = ["corridor-holds", "standoff", "corridor-lapses"][ctx.datasetIndex - 1];
                      return ` ${scName(sid)} (scenario published ${activeVersion}; adjusts the Sep 9 EIA forecast): ${signFmt(ctx.parsed.y)} mb since ${anchorMonthStr}`;
                    }
                    if (ctx.datasetIndex === 4)
                      return ` EIA forecast (production minus consumption, Sep 9, 2026 release): ${signFmt(ctx.parsed.y)} mb since ${anchorMonthStr}`;
                    if (ctx.datasetIndex === 5)
                      return ` Recent trend (Jun–Aug 2026 average, repeated): ${signFmt(ctx.parsed.y)} mb since ${anchorMonthStr}`;
                    return null;
                  },
                },
              },
            },
          },
          plugins: [
            crosshair,
            refLabels([{ value: 0, text: `0 — no change since ${anchorMonthStr}`, color: "#8a867a", align: "right" }]),
            directLabels(
              // Endpoint labels — values read from the records' stored final targets (rebased),
              // positioned by period, not index. Overlay labels (datasets 4–5) are skipped
              // automatically while the dataset is hidden (the plugin checks visibility).
              (() => {
                const out: { dataset: number; index: number; text: string; dy: number; color: string; font: string; align?: "right" | "left"; dx?: number }[] = [];
                const holdsEndP = scHoldsRec.targets[scHoldsRec.targets.length - 1].period;
                out.push({ dataset: 1, index: axisIdx(holdsEndP), text: `${signFmt(holdsLine[axisIdx(holdsEndP)]!)} — corridor holds`, align: "right" as "right" | "left", dx: -4, dy: -14, color: scColor("corridor-holds"), font: "10.5px Georgia, serif" });
                const standEndP = scStandoffRec.targets[scStandoffRec.targets.length - 1].period;
                out.push({ dataset: 2, index: axisIdx(standEndP), text: `${signFmt(standoffLine[axisIdx(standEndP)]!)} — standoff`, align: "right" as "right" | "left", dx: -4, dy: 18, color: scColor("standoff"), font: "10.5px Georgia, serif" });
                const lapseEndP = scLapseRec.targets[scLapseRec.targets.length - 1].period;
                // Below its endpoint: above, the label crossed the descending approach
                // segment (the line arrives from above). The y range leaves bottom room.
                out.push({ dataset: 3, index: axisIdx(lapseEndP), text: `${signFmt(lapseLine[axisIdx(lapseEndP)]!)} — corridor lapses`, align: "right" as "right" | "left", dx: -4, dy: 18, color: scColor("corridor-lapses"), font: "10.5px Georgia, serif" });
                const eiaDec26 = eiaRec.targets.find((t: any) => t.period === "2026-12");
                if (eiaDec26)
                  out.push({ dataset: 4, index: axisIdx("2026-12"), text: `${signFmt(eiaLine[axisIdx("2026-12")]!)} — EIA (Dec 2026)`, dy: 18, color: "#8a867a", font: "10.5px Georgia, serif" });
                const eiaEnd = eiaRec.targets[eiaRec.targets.length - 1].period;
                out.push({ dataset: 4, index: axisIdx(eiaEnd), text: `${signFmt(eiaLine[axisIdx(eiaEnd)]!)} — EIA forecast`, align: "right" as "right" | "left", dx: -4, dy: 16, color: "#8a867a", font: "10.5px Georgia, serif" });
                const persEnd = persRec.targets[persRec.targets.length - 1].period;
                out.push({ dataset: 5, index: axisIdx(persEnd), text: `${signFmt(persLine[axisIdx(persEnd)]!)} — recent trend`, align: "right" as "right" | "left", dx: -4, dy: 18, color: "#8a867a", font: "10.5px Georgia, serif" });
                return out;
              })()
            ),
          ],
        });
        // Opt-in overlays. Visibility is chart state only — it never touches the records,
        // so scoring (which reads the records) is unaffected by what is on screen.
        const wireOverlay = (id: string, ds: number) => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          el?.addEventListener("change", () => {
            const c = Chart.getChart(pbCanvas);
            if (!c) return;
            c.setDatasetVisibility(ds, el.checked);
            c.update();
          });
        };
        wireOverlay("toggleEia", 4);
        wireOverlay("toggleTrend", 5);
      }

      // Register chart instances for QA/debug scripts (harmless in production)
      for (const id of ["brentChart", "gasChart", "dieselChart", "crackChart", "gasTtfChart", "gasJkmChart", "treasury10yChart", "cpiChart"]) {
        (window as any).__charts[id] = Chart.getChart(document.getElementById(id)!);
      }
      (window as any).__charts["oecdStocksChart"] = Chart.getChart(document.getElementById("oecdStocksChart")!);
      (window as any).__charts["globalObservedChart"] = Chart.getChart(document.getElementById("globalObservedChart")!);
    </script>
  </body>
</html>

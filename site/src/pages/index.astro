      // Crack spread: retail product price less WTI, $/bbl (weekly).
      // Derived arithmetic on verified series (EIA/AAA retail, FRED WTI) — not a sourced print.
      // Gaps where FRED has no WTI value: null + spanGaps false = line breaks, no interpolation.
      // Nearest WTI within a few days (ties go to the later date): covers the product dates
      // with no same-day WTI — Jan 19→Jan 20, Feb 16→Feb 17, May 25→May 26,
      // Sep 6→Sep 8, the Sep 12–13 weekend AAA dailies → Sep 11 / Sep 14.
      // Sep 17 and Sep 18 pair with their same-day WTI settlements (101.91 / 100.30).
      // Sep 19 (Saturday) and Sep 20 (Sunday) pair with the Sep 18 settle — the weekend
      // convention for the Sep 12–13 AAA dailies. Sep 21 (Monday) pairs with its same-day
      // WTI settlement (95.78, October contract; Reuters). Sep 22 and Sep 23 (AAA releases)
      // pair with the Sep 22 WTI settlement (94.59, October contract — its final trading
      // day, per the Jiji settlement report) — the nearest settled session to each.
      // Data note (Sep 21 evening): the Sep 18 pass observed the Yahoo front-month bars at 99.29 /
      // 96.08 (read as a December-contract roll); a later pull shows the same bars at the
      // news-reported Nov/Oct settles (103.87 / 100.30). The observation was a transient
      // fetch artifact — the site's points are the news-reported settles throughout.
      // Observed values only, no interpolation.
      const wtiList = wtiWeekly.map((p) => ({ day: gd(p.date), value: p.value })).sort((a, b) => a.day - b.day);
      const nearestWti = (day: number) => {
        let best = wtiList[0];
        for (const w of wtiList) {
          const d = Math.abs(w.day - day), bd = Math.abs(best.day - day);
          if (d < bd || (d === bd && w.day > best.day)) best = w;
        }
        return best;
      };
      const crackPts = (pts: typeof gasolineYtd) =>
        pts.map((p) => {
          const w = nearestWti(gd(p.date));
          return { date: p.date, x: gd(p.date), y: +((p.value * 42 - w.value) * 10).toFixed(0) / 10 };
        });
      // WTI points that are futures closes, not the FRED weekly spot series — the tooltip
      // source label follows this (kept in step with the panel copy: "Sep 10–11 and Sep 14–22").
      const wtiNonFred = new Set(["2026-09-10", "2026-09-11", "2026-09-14", "2026-09-15", "2026-09-16", "2026-09-17", "2026-09-18", "2026-09-21", "2026-09-22"]);

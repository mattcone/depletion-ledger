      {
        const months: string[] = ws.series.oecd_onland_mb.points.map((p) => p.period);
        const mbVals: number[] = ws.series.oecd_onland_mb.points.map((p) => p.value);
        const band = ws.annotations.seasonal_band_2021_2025.by_month as Record<string, [number, number]>;
        const bandAt = (i: number): [number, number] | null => {
          const y = Number(months[i].slice(0, 4));
          // The band is the same calendar month's 2021–2025 range; it is applied to the
          // 2026 months too, because that's where the comparison matters most.
          return y >= 2021 && y <= 2026 ? band[months[i].slice(5)] : null;
        };
        const bandUpper = months.map((_, i) => bandAt(i)?.[1] ?? null);
        const bandLower = months.map((_, i) => bandAt(i)?.[0] ?? null);
        const warIdx = months.indexOf("2026-02");
        const warLine = {
          id: "warLine",

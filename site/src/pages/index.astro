    <script>
      import Chart from "chart.js/auto";
      import {
        brentYtd, wtiWeekly, gasolineYtd, gasolinePreCrisis, dieselYtd, dieselOldRecord,
        gasTtf, gasJkm, gasPreClosure,
        treasury10y, treasuryPreWar, treasuryTestLevel, cpiYtd, ppiYtd, fedCpiTarget,
        sprWeekly, sprFloors, sprScenarios, worldBalance,
        russiaCapacityAnchors, russiaCurrentSpread, recessionOdds, foodLagBars,
        usRefineryUtil2026, usRefineryUtil2025,
        commercialCrude2026, commercialCrude2025,
        worldConsumption2025, worldConsumption2026,
      } from "../data/crisis";

      // ---- Tufte chart treatment (tufte-data-viz skill) ----
      // No legends (direct labels), no gridlines (hover crosshair), no animation,
      // serif data text, plain tooltips, thin bottom axis only.
      // Debug handle for QA scripts (harmless in production)
      (window as any).__charts = (window as any).__charts || {};
      Chart.defaults.font.family = "Georgia, 'Times New Roman', serif";
      Chart.defaults.font.size = 11;
      Chart.defaults.color = "#8a867a";
      Chart.defaults.animation = false;
      Chart.defaults.plugins.legend.display = false;
      Chart.defaults.plugins.tooltip.backgroundColor = "rgba(255,255,248,0.97)";
      Chart.defaults.plugins.tooltip.titleColor = "#6b675c";
      Chart.defaults.plugins.tooltip.bodyColor = "#1c1b17";
      Chart.defaults.plugins.tooltip.borderWidth = 0;
      Chart.defaults.plugins.tooltip.cornerRadius = 2;
      Chart.defaults.plugins.tooltip.padding = 8;
      Chart.defaults.plugins.tooltip.displayColors = false;

      const xScale = {
        grid: { display: false },
        border: { display: true, color: "#d8d4c6", width: 0.5 },
        ticks: { color: "#8a867a", padding: 8 },
      };
      const yScale = (min: number, max: number, fmtTick: (v: unknown) => string, limit?: number) => ({
        min, max,
        grid: { display: false },
        border: { display: false },
        ticks: { color: "#8a867a", padding: 8, maxTicksLimit: limit, callback: fmtTick },
      });

      // Hover crosshair — replaces permanent gridlines
      const crosshair = {
        id: "crosshair",
        afterDatasetsDraw(chart: Chart) {
          const act = chart.tooltip?.getActiveElements();
          if (!act || !act.length) return;
          const { ctx, chartArea } = chart;
          const x = act[0].element.x;
          ctx.save();
          ctx.strokeStyle = "rgba(28,27,23,0.3)";
          ctx.lineWidth = 1;
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.moveTo(x, chartArea.top);
          ctx.lineTo(x, chartArea.bottom);
          ctx.stroke();
          ctx.restore();
        },
      };

      // Direct labels at specific data points (replaces legends)
      const directLabels = (specs: {
        dataset: number; index: number; text: string;
        dx?: number; dy?: number; align?: CanvasTextAlign;
        color?: string; font?: string;
      }[]) => ({
        id: "directLabels",
        afterDatasetsDraw(chart: Chart) {
          const { ctx } = chart;
          for (const s of specs) {
            const el = chart.getDatasetMeta(s.dataset).data[s.index];
            if (!el) continue;
            ctx.save();
            ctx.font = s.font || "italic 11.5px Georgia, serif";
            ctx.fillStyle = s.color || "#1c1b17";
            ctx.textAlign = s.align || "center";
            ctx.textBaseline = "middle";
            ctx.fillText(s.text, el.x + (s.dx ?? 0), el.y + (s.dy ?? -14));
            ctx.restore();
          }
        },
      });

      // Inline labels on horizontal reference lines
      const refLabels = (specs: {
        value: number; text: string; color: string; align: "left" | "right";
      }[]) => ({
        id: "refLabels",
        afterDatasetsDraw(chart: Chart) {
          const { ctx, chartArea, scales } = chart;
          for (const s of specs) {
            const y = scales.y.getPixelForValue(s.value);
            if (y < chartArea.top + 8 || y > chartArea.bottom - 6) continue;
            ctx.save();
            ctx.font = "10.5px Georgia, serif";
            ctx.fillStyle = s.color;
            ctx.textBaseline = "bottom";
            ctx.textAlign = s.align === "left" ? "left" : "right";
            ctx.fillText(s.text, s.align === "left" ? chartArea.left + 6 : chartArea.right - 6, y - 3);
            ctx.restore();
          }
        },
      });

      const fmt = (iso: string) =>
        new Date(iso + "T12:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric" });

      // Marker styling: filled = observed, hollow = source estimate
      const markers = (pts: { approx?: boolean }[], color: string) => ({
        pointRadius: pts.map(() => 3.5),
        pointBackgroundColor: pts.map((p) => (p.approx ? "#f2f1ec" : color)),
        pointBorderColor: color,
        pointBorderWidth: pts.map((p) => (p.approx ? 1.5 : 0)),
      });

      const endpoint = { font: "600 12.5px Georgia, serif", color: "#1c1b17", align: "right" as CanvasTextAlign, dx: -10, dy: -12 };
      const note = { font: "italic 11.5px Georgia, serif", color: "#8a867a" };

      // Brent chart (linear time + WTI weekly) is built below, after moneyXScale is defined.

      // The flip: world oil balance — surplus before the war, net withdrawals after.
      // Reported months only (STEO actuals Jan–Aug 2026); the forecast tail is deliberately
      // absent. The zero line is the protagonist; pre-war segments grey, post-war red.
      {
        const b0 = Date.parse("2026-01-01T12:00:00");
        const bday = (iso: string) => Math.round((Date.parse(iso + "T12:00:00") - b0) / 86400000);
        const bpts = worldBalance.map((p) => ({ x: bday(p.date), y: p.value }));
        new Chart(document.getElementById("flipChart")!, {
          type: "line",
          data: {
            datasets: [
              {
                label: "World balance",
                data: bpts,
                borderColor: "#b3261e",
                borderWidth: 2,
                // Gentle curve: monthly points, and the rest of the dashboard uses light tension.
                // Deliberately modest (0.2) — the flip is abrupt, and a strong curve would
                // soften the Feb→Mar break that is the whole point of the chart.
                tension: 0.2,
                segment: {
                  borderColor: (c) => (c.p0.parsed.y > 0 && c.p1.parsed.y > 0 ? "#8a867a" : "#b3261e"),
                },
                pointRadius: bpts.map((_, i) => (i === bpts.length - 1 ? 4 : 3)),
                pointBackgroundColor: bpts.map((_, i) => (i < 2 ? "#8a867a" : "#b3261e")),
                pointBorderColor: "#f2f1ec",
                pointBorderWidth: 1,
              },
              {
                label: "zero",
                data: [{ x: 0, y: 0 }, { x: 235, y: 0 }],
                borderColor: "#1c1b17",
                borderWidth: 1.5,
                pointRadius: 0,
                pointHitRadius: 0,
                pointHoverRadius: 0,
              },
              {
                label: "war begins",
                data: [
                  { x: bday("2026-02-28"), y: -6 },
                  { x: bday("2026-02-28"), y: 4.5 },
                ],
                borderColor: "rgba(28,27,23,0.35)",
                borderDash: [3, 3],
                borderWidth: 1,
                pointRadius: 0,
                pointHitRadius: 0,
                pointHoverRadius: 0,
              },
            ],
          },
          options: {

      // Floor-line hover message: an HTML tooltip that appears when the cursor is
      // within ~7px of a red floor line. Plain DOM — renders in any browser,
      // independent of the canvas tooltip machinery.
      {
        const tip = document.getElementById("sprFloorTip")!;
        const canvas = sprChart.canvas;
        canvas.addEventListener("mousemove", (e) => {
          const rect = canvas.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const area = sprChart.chartArea;
          const ys = sprChart.scales["y"];
          if (!area || !ys || x < area.left || x > area.right || y < area.top || y > area.bottom) {
            tip.classList.add("hidden");
            return;
          }
          let hitLevel = -1;
          let hitY = 0;
          for (const f of sprFloors) {
            const ly = ys.getPixelForValue(f.level);
            if (Math.abs(y - ly) <= 7) {
              hitLevel = f.level;
              hitY = ly;
              break;
            }
          }
          if (hitLevel < 0) {
            tip.classList.add("hidden");
            return;
          }
          tip.textContent = floorExplains[hitLevel];
          tip.classList.remove("hidden");
          let left = x + 14;
          if (left + tip.offsetWidth > canvas.clientWidth - 8) left = x - tip.offsetWidth - 14;
          tip.style.left = `${Math.max(8, left)}px`;
          tip.style.top = `${Math.max(8, hitY - 46)}px`;
        });
        canvas.addEventListener("mouseleave", () => tip.classList.add("hidden"));
      }

      // Panel A: OECD on-land stocks (commercial + government-controlled) — EIA monthly
      // levels (mb) + same-calendar-month 2021–2025 range (extended across 2026).

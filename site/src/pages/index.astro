      const gasDotKeep = new Set(gasCrackSrc.map((p) => p.date));
      const dieCrack = crackPts(dieselYtd);
      const gasCrack = crackPts(gasolineYtd);
      // Record label tracks the max, not a fixed offset from the end — new points keep landing.
      const dieRecIdx = dieCrack.reduce((mi, p, i, a) => ((p.y ?? -1) > (a[mi].y ?? -1) ? i : mi), 0);
      new Chart(document.getElementById("crackChart")!, {

              { dataset: 1, index: 1, text: "2021–2025 range", align: "left", dx: 4, dy: (chart) => (chart.width < 500 ? 12 : -31), color: "#8a6a1f" },
              { dataset: 2, index: mbVals.length - 1, text: `${mbVals[mbVals.length - 1].toLocaleString()} — lowest since Jan 2021`, align: "right", dx: -8, dy: 18 },

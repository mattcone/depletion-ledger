      const floorExplains: Record<number, string> = {
        300: "300M — the model's cavern-damage threshold. Below it, caverns can't safely be refilled after withdrawals. First report below this level: week ending Aug 7.",
        250: "250M — the operational minimum cited by the reserve's operators. No projected date: withdrawals run through DOE contracts and scheduled deliveries, and they could pause.",

            { dataset: 0, index: 0, text: "Jan · $89 — diesel", dx: 8, dy: 16, align: "left", color: "#8a867a" },
            { dataset: 1, index: 0, text: "Jan · $59 — gasoline", dx: 8, dy: -12, align: "left", color: "#8a867a" },
            { dataset: 1, index: 34, text: "Aug 31 · $84", dy: 16, align: "right", color: "#8a867a" },
            // Single annotation: the record. A second label on the last point crowded the
            // record label once the two separated; the caption carries the current value.
            { dataset: 0, index: dieRecIdx, text: `${fmt(dieCrack[dieRecIdx].date)} · $${(dieCrack[dieRecIdx].y ?? 0).toFixed(1)} — record`, dx: -8, dy: -16, align: "right", color: "#b3261e" },
          ]),

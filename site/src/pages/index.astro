              filter: (item: { datasetIndex: number }) => item.datasetIndex < 2,
              callbacks: {
                title: (items: { dataIndex: number; dataset: { label: string } }[]) => {
                  const it = items[0];
                  const arr = it.dataset.label === "US PPI YoY" ? ppiYtd : cpiYtd;
                  return fmt(arr[it.dataIndex].date);
                },
                label: (ctx: { dataIndex: number; dataset: { label: string } }) => {
                  const isPpi = ctx.dataset.label === "US PPI YoY";
                  const p = (isPpi ? ppiYtd : cpiYtd)[ctx.dataIndex];
                  return ` ${ctx.dataset.label}: ${p.value.toFixed(isPpi ? 1 : 2)}% YoY — BLS`;
                },
              },
            },
          },
        },
        plugins: [
          crosshair,
          refLabels([
            { value: fedCpiTarget, text: "Fed target 2%", color: "#8a867a", align: "right" },
          ]),
          directLabels([
            { dataset: 0, index: 1, text: "Feb · 2.4% — pre-war", dy: 18, color: "#8a867a" },
            { dataset: 0, index: 4, text: "May · 4.2% — CPI peak", dy: 18, color: "#1c1b17" },
            { dataset: 0, index: cpiYtd.length - 1, text: "Aug · 3.4% — flat", ...endpoint, dy: 18, color: "#1c1b17" },
            { dataset: 1, index: 4, text: "May · 5.9% — PPI peak", dy: -14, color: "#1c1b17" },
            { dataset: 1, index: ppiYtd.length - 1, text: "Aug · 5.4% — latest", ...endpoint, color: "#1c1b17" },
          ]),
        ],
      });

      // SPR: full 2026 weekly actuals + scenario paths + floors
      // Plain-language explanations for the four red floor lines — shown in an HTML
      // tooltip when the cursor is within a few pixels of a line (below).
      const floorExplains: Record<number, string> = {
        300: "300M — the model's cavern-damage threshold. Below it, caverns can't safely be refilled after withdrawals. First report below this level: week ending Aug 7.",
        250: "250M — the model's operational threshold. The dates assume continuing withdrawals: early October at 1.35M barrels a day, or late October at 0.70M. Actual deliveries could pause.",
        180: "180M — hard operable limit",
        70: "70M — the DOE's stated safe minimum: the draw stops here, it does not continue",
      };
      // Projected week-ending dates: derive from the last reported week (so a new WPSR
      // shifts them automatically) and format in UTC at noon so the label is identical
      // in every viewer's timezone.
      const futureWeeks: string[] = [];
      const _lastWeekEnd = Date.parse(sprWeekly[sprWeekly.length - 1].date + "T12:00:00Z");
      for (let w = 1; w <= 26; w++) {
        const d = new Date(_lastWeekEnd + w * 7 * 86400000);
        futureWeeks.push(d.toLocaleDateString("en-US", { timeZone: "UTC", month: "short", day: "numeric" }));
      }
      const sprLabels = [...sprWeekly.map((p) => fmt(p.date)), ...futureWeeks];
      const anchorIdx = sprWeekly.length - 1;
      // Scenario paths are clamped at the 70M DOE floor — the draw stops there, it does not continue.
      const scenarioLine = (rate: number) =>
        sprLabels.map((_, i) =>
          i <= anchorIdx ? (i === anchorIdx ? sprWeekly[anchorIdx].level : null) : Math.max(70, sprWeekly[anchorIdx].level - rate * 7 * (i - anchorIdx))
        );
      const sprChart = new Chart(document.getElementById("sprChart")!, {
        type: "line",
        data: {
          labels: sprLabels,
          datasets: [
            {
              label: "Actual (EIA weekly)",
              data: [...sprWeekly.map((p) => p.level), ...sprLabels.slice(anchorIdx + 1).map(() => null)],
              borderColor: "#1c1b17",
              borderWidth: 2,
              pointRadius: 0,
              tension: 0.1,
              spanGaps: false,
            },
            ...sprScenarios.map((s, i) => ({
              label: s.name,
              data: scenarioLine(s.rate),
              borderColor: ["#3d6b64", "#b4690e", "#b3261e"][i],
              borderDash: [5, 4],
              borderWidth: 1.5,
              pointRadius: 0,
              spanGaps: false,
            })),
            ...sprFloors.map((f) => ({
              label: f.name,
              data: sprLabels.map(() => f.level),
              borderColor: "rgba(179,38,30,0.35)",
              borderDash: [2, 5],
              borderWidth: 1,
              // Visible data point at the left edge, anchoring the inline label (like the dots on the other charts)
              pointRadius: sprLabels.map((_, i) => (i === 0 ? 3.5 : 0)),
              pointBackgroundColor: "rgba(179,38,30,0.85)",
              pointBorderColor: "rgba(179,38,30,0.85)",
            })),
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          scales: { y: yScale(60, 430, (v) => `${v}M`, 8), x: { ...xScale, ticks: { ...xScale.ticks, maxTicksLimit: 10 } } },
          plugins: {
            tooltip: {
              // Actuals in the past; projected levels on the scenario paths in the future.
              // (mode: "index" — hovering any week column lists every live line there; the
              // scenario datasets are null before the anchor, so past weeks show the actual only.)
              // The red floor lines carry their own hover message (the #sprFloorTip div, below).
              filter: (item) => item.datasetIndex < 4,
              callbacks: {
                label: (ctx) =>
                  ctx.datasetIndex === 0
                    ? ` ${ctx.parsed.y.toFixed(1)}M bbl (EIA weekly)`
                    : ` ${ctx.parsed.y.toFixed(1)}M bbl (projected — ${sprScenarios[ctx.datasetIndex - 1].name})`,
              },
            },
          },
        },
        plugins: [
          crosshair,
          // Floor lines are labeled inline (left) — replaces the legend
          refLabels([
            { value: 300, text: "300 · cavern (crossed early Aug)", color: "rgba(179,38,30,0.85)", align: "left" },
            { value: 250, text: "250 · GEF min", color: "rgba(179,38,30,0.6)", align: "left" },
            { value: 180, text: "180 · operable", color: "rgba(179,38,30,0.6)", align: "left" },
            { value: 70, text: "70 · DOE floor", color: "rgba(179,38,30,0.6)", align: "left" },
          ]),
          directLabels([
            // Actuals endpoint (the anchor where scenarios begin)
            { dataset: 0, index: anchorIdx, text: "285.0M · Sep 11", align: "right", dx: -12, dy: 16, font: "600 11.5px Georgia, serif" },
            // Scenario paths labeled at their ~March 2027 endpoints
            { dataset: 1, index: sprLabels.length - 1, text: "holds → 203M", align: "right", dx: -10, dy: 0, font: "11.5px Georgia, serif", color: "#3d6b64" },
            { dataset: 2, index: sprLabels.length - 1, text: "standoff → 158M", align: "right", dx: -10, dy: 0, font: "11.5px Georgia, serif", color: "#b4690e" },
            { dataset: 3, index: sprLabels.length - 1, text: "lapse → 70M floor", align: "right", dx: -10, dy: -14, font: "11.5px Georgia, serif", color: "#b3261e" },
          ]),
        ],
      });

      // Floor-line hover message: an HTML tooltip that appears when the cursor is
      // within ~7px of a red floor line. Plain DOM — renders in any browser,
      // independent of the canvas tooltip machinery.
      {
        const tip = document.getElementById("sprFloorTip")!;
        const canvas = sprChart.canvas;
        canvas.addEventListener("mousemove", (e) => {
          const rect = canvas.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const area = sprChart.chartArea;
          const ys = sprChart.scales["y"];
          if (!area || !ys || x < area.left || x > area.right || y < area.top || y > area.bottom) {
            tip.classList.add("hidden");
            return;
          }
          let hitLevel = -1;
          let hitY = 0;
          for (const f of sprFloors) {
            const ly = ys.getPixelForValue(f.level);
            if (Math.abs(y - ly) <= 7) {
              hitLevel = f.level;
              hitY = ly;
              break;
            }
          }
          if (hitLevel < 0) {
            tip.classList.add("hidden");
            return;
          }
          tip.textContent = floorExplains[hitLevel];
          tip.classList.remove("hidden");
          let left = x + 14;
          if (left + tip.offsetWidth > canvas.clientWidth - 8) left = x - tip.offsetWidth - 14;
          tip.style.left = `${Math.max(8, left)}px`;
          tip.style.top = `${Math.max(8, hitY - 46)}px`;
        });
        canvas.addEventListener("mouseleave", () => tip.classList.add("hidden"));
      }

      // Register chart instances for QA/debug scripts (harmless in production)
      for (const id of ["brentChart", "gasChart", "dieselChart", "crackChart", "gasTtfChart", "gasJkmChart", "treasury10yChart", "cpiChart"]) {
        (window as any).__charts[id] = Chart.getChart(document.getElementById(id)!);
      }
    </script>
  </body>
</html>

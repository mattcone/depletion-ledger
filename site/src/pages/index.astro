                title: (items: { dataIndex: number; dataset: { data: { date: string }[] } }[]) =>
                  fmt(items[0].dataset.data[items[0].dataIndex].date),
                label: (ctx: { dataIndex: number; dataset: { label: string } }) =>
                  ctx.parsed.y == null ? null : ` $${ctx.parsed.y.toFixed(1)} — ${ctx.dataset.label}`,
              },

---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteMeta from "../components/SiteMeta.astro";
import TopNav from "../components/TopNav.astro";
import ShippingRoutes from "../components/ShippingRoutes.astro";
import SupplyFlow from "../components/SupplyFlow.astro";
import {
  stats, brentYtd, brentMonthlyAvgs, wtiWeekly, gasolineYtd, gasolinePreCrisis,
  dieselYtd, dieselOldRecord, sprWeekly, sprFloors,
  branchWeights, branchTracks, watchGroups, cascade,
  DATA_AS_OF, CRISIS_DAY_1,
  russiaCapacityAnchors, russiaCurrentSpread, russiaSnapshot, russiaBanCascade,
  globalRefining, demandDecline,
  recessionOdds, ratesStats, foodStats, foodLagBars,
} from "../data/crisis";

// Crisis day number, computed from the data-as-of date (NOT the viewer's clock) so the
// page is a stable snapshot: Sep 23 data = day 207, no matter when someone loads it.
const dayNum = Math.round((Date.parse(DATA_AS_OF) - Date.parse(CRISIS_DAY_1)) / 86400000);

// ── World oil stocks panels (below the flip chart) ─────────────────────────────
// Every computed number in the panel copy/captions is derived from the data file,
// not re-typed — re-typed arithmetic already produced one wrong residual.
import worldStocksData from "../data/world-stocks.json";
const wsMb = worldStocksData.series.oecd_onland_mb.points;
const wsBand = worldStocksData.annotations.seasonal_band_2021_2025.by_month as Record<string, number[]>;
const wsMbFirst = wsMb[0];
const wsMbLast = wsMb[wsMb.length - 1];
// Panel B no longer draws the historical bars/dots (the redesign rebased the panel onto
// the forecast anchor); their underlying series stay in world-stocks.json untouched.
const monthFull = ["January","February","March","April","May","June","July","August","September","October","November","December"];
const wsBelowBandMonths = wsMb
  .filter((p) => p.period.startsWith("2026") && wsBand[p.period.slice(5)] && p.value < wsBand[p.period.slice(5)][0])
  .map((p) => monthFull[parseInt(p.period.slice(5), 10) - 1]);
// Pre-rendered strings for the templates (Astro's {{ }} parser dislikes method calls).
const wsBelowBandStr = wsBelowBandMonths.join(" and ");
const wsMbFirstStr = wsMbFirst.value.toLocaleString();
const wsMbLastStr = wsMbLast.value.toLocaleString();
// aria-labels are built in the frontmatter: expressions don't expand inside quoted attributes.
// Every figure in the aria text is derived from the data file, not re-typed.
const wsDec22 = wsMb.find((p) => p.period === "2022-12")?.value ?? 0;
const ws2325 = wsMb.filter((p) => p.period >= "2023-01" && p.period <= "2025-12");
const ws2325Lo = Math.min(...ws2325.map((p) => p.value));
const ws2325Hi = Math.max(...ws2325.map((p) => p.value));
const wsPanelAAria = `OECD on-land oil stocks, commercial plus government-controlled, million barrels. The EIA's monthly levels from ${wsMbFirst.value.toLocaleString()} in January 2021, falling to ${wsDec22.toLocaleString()} by December 2022, then holding between ${ws2325Lo.toLocaleString()} and ${ws2325Hi.toLocaleString()} across 2023 to 2025, then dropping to ${wsMbLastStr} by May 2026 — the lowest month in the series. The shaded band is the same calendar month's range over 2021 to 2025, extended across 2026; ${wsBelowBandStr} 2026 fall below it. A dashed line marks the start of the war, February 28, 2026.`;
// Forecast paths come from the forecast records — the stored targets are the source of truth,
// so the copy, the chart, and the record can never drift apart.
const wsEiaRec = (worldStocksData as any).forecast_records.find((r: any) => r.record_id === "steo-2026-09-global-observed");
const wsPersRec = (worldStocksData as any).forecast_records.find((r: any) => r.record_id === "persistence-2026-09-global-observed");
// The scenario names and colors live in the assumptions file, not in the chart code.
import worldStocksAssumptions from "../data/world-stocks-assumptions.json";
// Active scenario version: the newest version date among the scenario records
// (record_id = scenario-<sid>-<YYYY-MM-DD>-global-observed). The same rule is used
// by the chart code below and by research/scoring/regen-scenarios.py (checker +
// table generator). Older versions stay in the data for scoring; the page — copy,
// captions, aria, and plotted lines — always uses the active version.
const wsScenarioVersion = (worldStocksData as any).forecast_records
  .filter((r: any) => typeof r.record_id === "string" && r.record_id.startsWith("scenario-"))
  .reduce((max: string, r: any) => {
    const m = r.record_id.match(/-(\d{4}-\d{2}-\d{2})-global-observed$/);
    return m && m[1] > max ? m[1] : max;
  }, "");
const wsScHoldsRec = (worldStocksData as any).forecast_records.find((r: any) => r.record_id === `scenario-corridor-holds-${wsScenarioVersion}-global-observed`);
const wsScStandoffRec = (worldStocksData as any).forecast_records.find((r: any) => r.record_id === `scenario-standoff-${wsScenarioVersion}-global-observed`);
const wsScLapseRec = (worldStocksData as any).forecast_records.find((r: any) => r.record_id === `scenario-corridor-lapses-${wsScenarioVersion}-global-observed`);
const wsPersF = worldStocksData.series.persistence_baseline_mb.points;
// The copy's anchor comes from the SAVED record, not the latest observation: when the
// observation is revised or extended (e.g. September publishes), the description of the
// forecast's fixed starting point must not move with it.
const wsFcAnchorRec = wsEiaRec.anchor;
const wsFcAnchorMonthStr = new Date(wsFcAnchorRec.period + "-15T12:00:00").toLocaleDateString("en-US", { month: "long", year: "numeric" });
const wsMonthStr = (ym: string) => new Date(ym + "-15T12:00:00").toLocaleDateString("en-US", { month: "long", year: "numeric" });
// Panel B rebases every displayed path to the shared anchor: displayed = stored − stored
// anchor. That is a DISPLAY transform only — the stored records are the source of truth
// and are never modified. All five paths must agree on the anchor before any of them can
// be compared on one shared zero.
const wsAnchorRecords = [wsEiaRec, wsPersRec, wsScHoldsRec, wsScStandoffRec, wsScLapseRec];
if (!wsAnchorRecords.every((r: any) => r.anchor.period === wsFcAnchorRec.period && r.anchor.value_mb === wsFcAnchorRec.value_mb)) {
  throw new Error("Panel B: forecast records disagree on the anchor period/value; the rebased paths would not share a zero.");
}
const wsRebase = (v: number) => v - wsFcAnchorRec.value_mb;
const wsPersMonthly = wsPersF[0].value;
// Endpoint values come from the records' final stored targets, rebased to the shared
// anchor — the lapse record's final target is its validity horizon (Dec 2027 for the
// v2026-09-18 conditional extension), so every month name is derived, not re-typed.
const wsScHoldsEnd = wsScHoldsRec.targets[wsScHoldsRec.targets.length - 1];
const wsScStandoffEnd = wsScStandoffRec.targets[wsScStandoffRec.targets.length - 1];
const wsScLapseEnd = wsScLapseRec.targets[wsScLapseRec.targets.length - 1];
const wsEiaEnd = wsEiaRec.targets[wsEiaRec.targets.length - 1];
const wsPersEnd = wsPersRec.targets[wsPersRec.targets.length - 1];
const wsLapseEndMonthStr = wsMonthStr(wsScLapseEnd.period);
const wsSigned = (v: number) => `${v > 0 ? "+" : "−"}${Math.abs(Math.round(v)).toLocaleString()}`;
const wsHoldsEndStr = wsSigned(wsRebase(wsScHoldsEnd.target_cumulative_mb));
const wsStandoffEndStr = wsSigned(wsRebase(wsScStandoffEnd.target_cumulative_mb));
const wsLapseEndStr = wsSigned(wsRebase(wsScLapseEnd.target_cumulative_mb));
const wsHoldsEndMonthStr = wsMonthStr(wsScHoldsEnd.period);
const wsEiaEndStr = wsSigned(wsRebase(wsEiaEnd.target_cumulative_mb));
const wsPersEndStr = wsSigned(wsRebase(wsPersEnd.target_cumulative_mb));
const wsPersMonthlyStr = `−${Math.abs(wsPersMonthly).toFixed(1)}`;
const wsPanelBAria = `Line chart of the change in global oil inventories since ${wsFcAnchorMonthStr}, in million barrels, starting at zero in ${wsFcAnchorMonthStr} — zero means inventories unchanged since that month, not empty storage. Three scenarios adjust the Sep 9, 2026 EIA production and consumption forecast, using assumptions explained on the model page: corridor holds (solid) reaches ${wsHoldsEndStr} by ${wsHoldsEndMonthStr}; standoff (dashed) reaches ${wsStandoffEndStr}; corridor lapses (long dashed) reaches ${wsLapseEndStr} by ${wsLapseEndMonthStr}, the final month calculated. Two optional comparisons, hidden until selected: the EIA Short-Term Energy Outlook (Sep 9, 2026 release) world stock change calculated from production minus consumption, ${wsEiaEndStr} by ${wsMonthStr(wsEiaEnd.period)}; and the recent trend, which repeats the June–August 2026 average monthly change (${wsPersMonthlyStr} million barrels a month), ${wsPersEndStr} by ${wsMonthStr(wsPersEnd.period)}. All lines combine crude oil and refined fuels, and none counts government stock releases as a loss.`;

// Watch list as flat ledger rows (date column + text). Tufte: structure from the date
// column and whitespace, not boxes or shaded bands.
const watchRows: { when: string; item: string; why: string; breakBefore: boolean }[] = [];
for (const grp of watchGroups) {
  for (const w of grp.items) {
    watchRows.push({
      when: grp.when, item: w.item, why: w.why,
      breakBefore: watchRows.length > 0 && watchRows[watchRows.length - 1].when !== grp.when,
    });
  }
}

// Data-as-of date, formatted (UTC so it's deterministic regardless of build timezone)
const dataAsOf = new Date(DATA_AS_OF + "T12:00:00").toLocaleDateString("en-US", {
  timeZone: "UTC",
  year: "numeric",
  month: "short",
  day: "numeric",
});

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The Depletion Ledger — The Oil Supply Crisis</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content={`Track the 2026 oil supply crisis with charts of fuel prices, oil reserves, and effects on the economy. Day ${dayNum}, data as of ${dataAsOf}.`}
    />
    <SiteMeta
      title="The Depletion Ledger — The Oil Supply Crisis"
      description={`Track the 2026 oil supply crisis with charts of fuel prices, oil reserves, and effects on the economy. Day ${dayNum}, data as of ${dataAsOf}.`}
      url="/"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <!-- Top nav (shared component — identical on every page) -->
      <TopNav current="home" />

      <!-- Hero: title + chokepoint map -->
      <header class="grid gap-8 border-b border-rule py-12 lg:grid-cols-[1fr_480px] lg:items-center lg:gap-16">
        <div>
          <h1 class="text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl">
            The Depletion Ledger
          </h1>
          <div class="mt-3 max-w-prose space-y-3 text-[15px] leading-relaxed text-ink/80">
            <p>
              Oil is part of everyday life, even when you don't think about it. It's refined into
              fuels that power cars, move goods, and help farmers grow our food. It's also used to
              make things like the clothes we wear.
            </p>
            <p>
              Since the US and Israel went to war with Iran in February 2026, the world has been
              using more oil than it produces. The Strait of Hormuz and the Red Sea are
              effectively closed to oil shipping, cutting off roughly 20% of the world's oil
              supply. Russian refinery strikes and export bans are making the situation worse.
              The US Strategic Petroleum Reserve is at its lowest level since 1982.
            </p>
            <p>
              The Depletion Ledger tracks oil supplies, fuel prices, and how the shortage affects
              people and businesses. You can use the charts below to see what's changed and explore
              three possible outcomes. We estimate the chance of each one and how it could change
              the amount of oil in storage. We save the predictions so you can check them against
              what happens.
            </p>
          </div>
          <p class="mt-4 font-mono text-xs text-faint tabular">
            Last updated {dataAsOf}
          </p>
          <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-sm">
            <a class="underline decoration-rule underline-offset-4 hover:decoration-crude" href="#prices">Prices</a>
            <a class="underline decoration-rule underline-offset-4 hover:decoration-crude" href="#supply">Supply</a>
            <a class="underline decoration-rule underline-offset-4 hover:decoration-crude" href="#refining">Refining</a>
            <a class="underline decoration-rule underline-offset-4 hover:decoration-crude" href="#secondorder">Effects on the economy</a>
            <a class="underline decoration-rule underline-offset-4 hover:decoration-crude" href="#watchlist">Watch list</a>
          </nav>
        </div>



        <!-- Chokepoint map: the geography of the crisis -->
        <figure class="mx-auto w-full max-w-[480px]">
          <svg viewBox="0 0 320 265" role="img" aria-label="Map of the crisis area: the Red Sea between Africa and the Arabian Peninsula, narrowing to the strait of Bab el-Mandeb; and the Persian Gulf between Saudi Arabia and Iran, exiting through the Strait of Hormuz. Both chokepoints are marked with red dots.">
            <!-- country coastlines: Natural Earth 110m (public domain) -->

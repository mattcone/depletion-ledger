            ctx.save();
            ctx.strokeStyle = "rgba(179,38,30,0.45)";
            ctx.setLineDash([4, 4]);
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(x, top);
            ctx.lineTo(x, bottom);
            ctx.stroke();
            ctx.setLineDash([]);
            ctx.fillStyle = "#b3261e";
            ctx.font = "italic 10.5px Georgia, serif";
            // Left of the line so the text stays inside the canvas at narrow widths.
            ctx.textAlign = "right";
            ctx.fillText("War begins", x - 6, top + 10);
            ctx.restore();

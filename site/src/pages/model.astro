---
import { getEntry, render } from "astro:content";
import ArticleShell from "../components/ArticleShell.astro";
import {
  DATA_AS_OF,
  branchWeights,
} from "../data/crisis.ts";
import worldStocksData from "../data/world-stocks.json";

const entry = await getEntry("docs", "model");
if (!entry) throw new Error("model entry missing");
const { Content } = await render(entry);

const odds = branchWeights[branchWeights.length - 1];
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const asOf = fmtDate(new Date(`${DATA_AS_OF}T00:00:00Z`));
const sections = [
  ["what-the-model-tells-you", "What the model tells you"],
  ["how-to-read-the-chart", "How to read the chart"],
  ["how-the-paths-are-calculated", "How the paths are calculated"],
  ["what-each-scenario-assumes", "Scenario assumptions"],
  ["the-september-2026-audit", "The September audit"],
  ["the-september-19-assumptions-preserved", "The September 19 assumptions"],
  ["what-the-model-leaves-out", "What the model leaves out"],
  ["how-the-odds-change", "How the odds change"],
  ["how-we-check-the-predictions", "Checking the predictions"],
  ["where-the-data-comes-from", "Data sources"],
  ["where-the-spr-fits-now", "Where the SPR fits now"],
  ["forecast-results", "Forecast results"],
];

// The full score history (moved from the dashboard Oct 16): a continuing ledger of
// EVERY scored month, oldest first. Every released version of each scenario is shown
// for each month it scores, so a future revision never drops the original lines from
// the ledger. The two known drafts — Sep 17 and Sep 18, superseded within a day or two
// of the Sep 19 release — are excluded by a named list, not inferred from elapsed time
// (a time rule would retrospectively hide any genuine version revised quickly). The
// benchmarks are the latest EIA STEO edition with an outcome for the month and the
// persistence baseline. Values are rebased to the frozen August anchor, like the
// original chart below; each figure is frozen at first release.
const wsLedgerAnchor = (worldStocksData as any).forecast_records
  .find((r: any) => r.record_id === "scenario-corridor-holds-2026-09-19-global-observed")?.anchor ?? { value_mb: -507 };
const wsLedgerRebase = (v: number) => v - wsLedgerAnchor.value_mb;
const wsLedgerMonthStr = (ym: string) => new Date(ym + "-15T12:00:00").toLocaleDateString("en-US", { month: "long", year: "numeric" });
const wsScenarioVersions: { scenario: string; issued: string }[] = (worldStocksData as any).forecast_records
  .filter((r: any) => typeof r.record_id === "string" && r.record_id.startsWith("scenario-"))
  .map((r: any) => {
    const m = r.record_id.match(/^scenario-(.+)-(\d{4}-\d{2}-\d{2})-global-observed$/);
    return m ? { scenario: m[1], issued: m[2] } : null;
  })
  .filter((v: any) => v)
  .sort((a: any, b: any) => a.issued.localeCompare(b.issued) || a.scenario.localeCompare(b.scenario));
const wsDraftIssues = new Set(["2026-09-17", "2026-09-18"]);
type wsLedgerRow = { name: string; target: number; observed: number; miss: number };
type wsLedgerMonth = { monthStr: string; rows: wsLedgerRow[] };
const wsScoreHistory: wsLedgerMonth[] = (() => {
  const scored = new Set<string>();
  for (const r of (worldStocksData as any).forecast_records)
    for (const t of (r.targets || []))
      if (t.outcome_first_release?.cumulative_mb != null) scored.add(t.period);
  const byId = (id: string) => (worldStocksData as any).forecast_records.find((r: any) => r.record_id === id);
  const push = (rows: wsLedgerRow[], rec: any, name: string, mk: string) => {
    const t = (rec?.targets || []).find((t: any) => t.period === mk && t.outcome_first_release?.cumulative_mb != null);
    if (!t) return;
    const target = wsLedgerRebase(t.target_cumulative_mb);
    const observed = wsLedgerRebase(t.outcome_first_release.cumulative_mb);
    rows.push({ name, target, observed, miss: Math.abs(target - observed) });
  };
  return [...scored].sort()
    .map((mk) => {
      const rows: wsLedgerRow[] = [];
      for (const [sc, label] of [["standoff", "Standoff"], ["corridor-holds", "Corridor holds"], ["corridor-lapses", "Corridor lapses"]] as [string, string][]) {
        for (const v of wsScenarioVersions.filter((x: any) => x.scenario === sc)) {
          if (wsDraftIssues.has(v.issued)) continue;
          push(rows, byId(`scenario-${sc}-${v.issued}-global-observed`), `${label} (${v.issued})`, mk);
        }
      }
      const steo = (worldStocksData as any).forecast_records
        .filter((r: any) => typeof r.record_id === "string" && r.record_id.startsWith("steo-") && (r.targets || []).some((t: any) => t.period === mk && t.outcome_first_release?.cumulative_mb != null))
        .sort((a: any, b: any) => b.record_id.localeCompare(a.record_id));
      if (steo.length) {
        const ed = new Date(steo[0].issued + "T12:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric" });
        push(rows, steo[0], `EIA estimate (${ed} edition)`, mk);
      }
      const pers = (worldStocksData as any).forecast_records.find((r: any) => typeof r.record_id === "string" && r.record_id.startsWith("persistence-") && (r.targets || []).some((t: any) => t.period === mk && t.outcome_first_release?.cumulative_mb != null));
      if (pers) push(rows, pers, "Recent trend (persistence)", mk);
      return { monthStr: wsLedgerMonthStr(mk), rows };
    })
    .filter((m: wsLedgerMonth) => m.rows.length > 0);
})();
---

<ArticleShell current="model" title={entry.data.title} description={entry.data.description}>
  <!-- Hero: finding title + lead, dashboard type -->
  <header class="border-b border-rule py-12">
    <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-faint">
      Model · updated {asOf}
    </p>
    <h1 class="mt-3 max-w-4xl text-3xl font-extrabold leading-[1.08] tracking-tight sm:text-4xl">
      How the model works
    </h1>
    <p class="mt-4 max-w-3xl text-[15px] leading-relaxed text-ink/80">
      How could the world's oil stocks change if shipping recovers, the standoff
      continues, or the disruption gets worse? Here's what goes into each scenario,
      where we make assumptions, and how we check the results.
    </p>
  </header>

  <!-- Body: prose + sticky marginalia rail -->
  <!-- minmax(0,1fr) on the mobile track + min-w-0 on the article: wide tables scroll
       inside their own block (global.css .prose-oil table {display:block; overflow-x:auto})
       instead of stretching the document past the viewport. -->
  <div class="grid grid-cols-[minmax(0,1fr)] gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-14">
    <article class="prose-oil model-copy min-w-0">
      <Content />
      <!-- Forecast results (the full score history, moved from the dashboard Oct 16)
           + the original September 19 chart: the dashboard keeps a one-line
           disclosure and links here; the ledger and the v1 archive live on this page. -->
      <section id="forecast-results" class="mt-12 border-t border-rule pt-8">
        <h2 class="text-xl font-bold tracking-tight">Forecast results and the original chart</h2>
        <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink/80">
          Here you can compare every published line with the reported results, month by
          month, and see the original September 19 (v1) paths. Every scored month appears
          below, oldest first; when a scenario is revised, the original lines stay in the
          ledger for the months they scored. Figures are in million barrels, measured from
          the saved August 2026 starting value.
          The scenarios were less accurate than the recent-trend baseline in the first
          scored month.
        </p>

        <h3 class="mt-6 text-base font-bold tracking-tight">The scorecard</h3>
        <p class="mt-2 max-w-prose text-xs leading-relaxed text-faint">
          “Target” is the prediction and “Observed” is the reported result. “Miss” is the
          distance between them. September's reported withdrawal was 10 million barrels.
          The −2 shown here compares September's running total (−509) with our saved August
          value (−507). Revisions to earlier months account for the 8 million barrel difference.
        </p>
        <div class="mt-3 max-w-2xl overflow-x-auto">
          <table class="w-full border-collapse text-left text-[13px]">
            <thead>
              <tr class="border-b border-rule text-faint">
                <th class="pb-2 pr-4 font-semibold">Month</th>
                <th class="pb-2 pr-4 font-semibold">Line</th>
                <th class="pb-2 pr-4 text-right font-semibold">Target</th>
                <th class="pb-2 pr-4 text-right font-semibold">Observed</th>
                <th class="pb-2 text-right font-semibold">Miss</th>
              </tr>
            </thead>
            <tbody>
              {wsScoreHistory.map((m) => (
                m.rows.map((r, i) => (
                  <tr class="border-b border-rule/60">
                    <td class="py-2 pr-4">{i === 0 ? m.monthStr : ""}</td>
                    <td class="py-2 pr-4">{r.name}</td>
                    <td class="py-2 pr-4 text-right tabular-nums">{r.target > 0 ? "+" : ""}{r.target.toFixed(1)}</td>
                    <td class="py-2 pr-4 text-right tabular-nums">{r.observed > 0 ? "+" : ""}{r.observed.toFixed(1)}</td>
                    <td class="py-2 text-right font-semibold tabular-nums">{r.miss.toFixed(1)}</td>
                  </tr>
                ))
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 max-w-prose text-xs leading-relaxed text-faint">
          Each figure is frozen at first publication; a published month is never
          re-scored. The scenario targets are EIA-based and the observed line is the IEA's
          reported total — different measures, so part of the apparent miss is an
          unresolved difference between the agencies' figures, not a measured forecast
          error: in the first scored month the recent-trend baseline missed by 46 million
          barrels, and every scenario missed by more. The September standoff miss (94
          million) is broken down in <a class="underline decoration-rule underline-offset-2 hover:text-ink" href="#the-september-2026-audit">the September audit</a>.
        </p>

        <h3 class="mt-8 text-base font-bold tracking-tight">The original September 19 chart</h3>
        <p class="mt-2 max-w-prose text-xs leading-relaxed text-faint">
          These are the original September 19 (v1) paths, starting at August's zero.
          You can see the revised October 15 (v2) paths on the dashboard.
        </p>
        <div class="relative mt-4 h-80 sm:h-[380px]">
          <canvas id="v1Chart" role="img" aria-label="Line chart of the original September 19 (v1) scenario paths, in million barrels relative to the saved August 2026 anchor, from September 2026 to December 2027. Corridor holds (solid) reaches +1,736 by December 2027; standoff (dashed) reaches −1,326; corridor lapses (long dashed) reaches −2,988."></canvas>
        </div>
      </section>
    </article>

    <aside class="hidden self-start text-sm lg:sticky lg:top-8 lg:block">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-faint">
        On this page
      </p>
      <nav aria-label="Model sections" class="mt-4">
        <ul class="space-y-2">
          {sections.map(([id, label]) => (
            <li><a class="text-[13px] text-ink/70 hover:text-ink hover:underline" href={`#${id}`}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <p class="mt-6 text-xs text-faint">Scenario probabilities · {odds.date}</p>
      <dl class="mt-3 space-y-3">
        {[["Corridor holds", odds.holds], ["Standoff", odds.standoff], ["Corridor lapses", odds.lapse]].map(([label, value]) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-[13px] leading-snug text-ink/70">{label}</dt>
            <dd class="tabular whitespace-nowrap font-mono text-[13px] font-semibold text-ink">{value}%</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-xs leading-relaxed text-faint">
        These percentages show how likely we consider each outcome. They don't tell
        you how accurate the storage figures will be.
      </p>
    </aside>
  </div>

  <script>
    import Chart from "chart.js/auto";
    import wsV1 from "../data/world-stocks.json";
    const v1recs = [
      { id: "scenario-corridor-holds-2026-09-19-global-observed", label: "Corridor holds (Sep 19)", color: "#2f2c26", dash: [] as number[] },
      { id: "scenario-standoff-2026-09-19-global-observed", label: "Standoff (Sep 19)", color: "#6b675c", dash: [6, 4] as number[] },
      { id: "scenario-corridor-lapses-2026-09-19-global-observed", label: "Corridor lapses (Sep 19)", color: "#a39d8f", dash: [2, 3] as number[] },
    ];
    const v1records = (wsV1 as any).forecast_records as any[];
    const v1anchor = v1records.find((r) => r.record_id === v1recs[0].id)?.anchor ?? { period: "2026-08", value_mb: -507 };
    const v1rebase = (v: number) => v - v1anchor.value_mb;
    const v1axisSet = new Set<string>([v1anchor.period]);
    for (const r of v1recs) {
      const rec = v1records.find((x) => x.record_id === r.id);
      for (const t of rec?.targets ?? []) v1axisSet.add(t.period);
    }
    const v1labels = [...v1axisSet].sort();
    const v1fmt = (p: string) => new Date(p + "-15T12:00:00").toLocaleDateString("en-US", { month: "short", year: "2-digit" });
    new Chart(document.getElementById("v1Chart")!, {
      type: "line",
      data: {
        labels: v1labels.map(v1fmt),
        datasets: v1recs.map((r) => {
          const rec = v1records.find((x) => x.record_id === r.id);
          return {
            label: r.label,
            data: v1labels.map((m) => {
              const t = (rec?.targets ?? []).find((t: any) => t.period === m);
              if (t) return v1rebase(t.target_cumulative_mb);
              if (m === v1anchor.period) return 0;
              return null;
            }),
            borderColor: r.color,
            borderWidth: 1.8,
            borderDash: r.dash,
            pointRadius: 0,
            tension: 0,
            fill: false,
          };
        }),
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: "index", intersect: false },
        plugins: {
          legend: { position: "top" },
          tooltip: {
            callbacks: {
              label: (c: any) => ` ${c.dataset.label}: ${c.parsed.y == null ? "—" : Math.round(c.parsed.y) + " mb"}`,
            },
          },
        },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 10 } } },
          y: { title: { display: true, text: "mb since Aug 2026" }, ticks: { font: { size: 10 } } },
        },
      },
    } as any);
  </script>

</ArticleShell>

<style>
  .model-copy :global(> blockquote:first-child) {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    border-left-color: var(--color-crude);
    background: var(--color-paper-deep);
    color: var(--color-ink);
  }

  .model-copy :global(details) {
    padding: 0.5rem 0;
  }

  .model-copy :global(summary) {
    cursor: pointer;
    font-weight: 600;
  }

  .model-copy :global(summary:focus-visible) {
    outline: 2px solid var(--color-crude);
    outline-offset: 4px;
  }

  .model-copy :global(details > * + *) {
    margin-top: 1em;
  }

  .model-copy :global(h2) {
    border-top: none;
    padding-top: 0;
    scroll-margin-top: 1rem;
  }

  .model-copy :global(code) {
    overflow-wrap: anywhere;
  }
</style>
